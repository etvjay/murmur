+    /// viewing keys, note plaintexts and derivation paths.
+    #[arg(long)]
+    raw: bool,
+}
 
 impl Command {
     pub(crate) async fn run(self) -> Result<(), anyhow::Error> {
@@ -31,7 +38,15 @@ impl Command {
