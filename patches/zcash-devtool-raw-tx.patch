+            use std::io::Write;
+            let mut raw = vec![];
+            tx.write(&mut raw)?;
+            eprintln!("{txid}");
+            std::io::stdout().write_all(&raw)?;
+        } else {
+            println!("{txid}");
+        }
         Ok(())
     }
 }
